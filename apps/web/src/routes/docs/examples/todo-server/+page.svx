<script lang="ts">
	import { ComponentPreview, Step, Steps } from '$lib';
	import TodoServerDemo from './_TodoServerDemo.svelte';

	const storeSource = `// src/lib/server/todos.ts
//
// サーバー側だけで使う「保存場所」。
// $lib/server/ 以下に置くと、ブラウザには絶対に渡らない。
// 今回はメモリで持つだけ。実務では DB（Postgres など）に置きかえる。

export type Todo = {
	id: number;
	description: string;
};

let todos: Todo[] = [];
let nextId = 1;

export function getTodos(): Todo[] {
	return todos;
}

export function createTodo(description: string): Todo {
	const todo: Todo = { id: nextId++, description };
	todos.push(todo);
	return todo;
}

export function deleteTodo(id: number): void {
	todos = todos.filter((t) => t.id !== id);
}
`;

	const pageServerSource = `// src/routes/todos/+page.server.ts
//
// サーバー側でしか動かないコード。
// load = ページ表示前の材料集め
// actions = フォームの受付係

import { fail } from '@sveltejs/kit';
import { createTodo, deleteTodo, getTodos } from '$lib/server/todos';
import type { Actions, PageServerLoad } from './$types';

export const load: PageServerLoad = () => {
	return {
		todos: getTodos()
	};
};

export const actions: Actions = {
	create: async ({ request }) => {
		const data = await request.formData();
		const description = String(data.get('description') ?? '').trim();

		if (description === '') {
			return fail(422, {
				error: 'やることを入力してください',
				description
			});
		}

		createTodo(description);
		return { ok: true };
	},

	delete: async ({ request }) => {
		const data = await request.formData();
		const id = Number(data.get('id'));
		deleteTodo(id);
		return { ok: true };
	}
};
`;

	const pageSource = `<!-- src/routes/todos/+page.svelte -->
<script lang="ts">
	import { enhance } from '$app/forms';
	let { data, form } = $props();
<\/script>

<h1>やることリスト</h1>

{#if form?.error}
	<p class="error" role="alert">{form.error}</p>
{/if}

<form method="POST" action="?/create" use:enhance>
	<input
		type="text"
		name="description"
		placeholder="やることを書く"
		value={form?.description ?? ''}
	/>
	<button type="submit">追加</button>
</form>

{#if data.todos.length === 0}
	<p>やることはまだありません 🎉</p>
{:else}
	<ul>
		{#each data.todos as todo (todo.id)}
			<li>
				<span>{todo.description}</span>
				<form method="POST" action="?/delete" use:enhance>
					<input type="hidden" name="id" value={todo.id} />
					<button type="submit" aria-label="{todo.description} を削除">×</button>
				</form>
			</li>
		{/each}
	</ul>
{/if}
`;
</script>

## ひとことで言うと

サーバー保存版では、Todo を**ブラウザだけでなく、サーバー側の処理に送って保存**します。
別の端末から見ても、別のブラウザから見ても、**みんなが同じ Todo を見られる**のがゴールです。

主役は SvelteKit の `+page.server.ts` ／ [`load`](/docs/sveltekit/load) ／ [`form actions`](/docs/sveltekit/form-actions) です。

## 今回のゴール

- `load` で **Todo 一覧を読みこむ**
- `form actions` で **Todo を追加する**
- **named actions** で削除も扱う（同じページに2つ以上のフォーム）
- `fail` でバリデーションエラーをやさしく返す
- `use:enhance` でページ全体をリロードせずに送信する

> このページは、[前回の Todo](/docs/examples/todo)・[localStorage 版](/docs/examples/todo-localstorage) と同じUIを、**保存場所だけサーバーに置きかえる**形で進みます。
> 「**変えたのはここだけ**」がはっきり見えるよう、UI はあえてそのままです。

## これまでの Todo との違い

| 版 | 保存場所 | 閉じても残る？ | 別端末から見られる？ | 実務に近いか |
| --- | --- | --- | --- | --- |
| [ローカル版](/docs/examples/todo) | メモリ（タブの中だけ） | × | × | △ 練習向け |
| [localStorage 版](/docs/examples/todo-localstorage) | ブラウザのメモ帳 | ◯（同じブラウザだけ） | × | ◯ 個人ツール向け |
| **サーバー版（今回）** | **サーバー（メモリ→将来は DB）** | ◯ | ◯ | ◎ 業務アプリの基本 |

「**みんなで同じ Todo を見たい**」と思った瞬間、答えは**サーバー保存**になります。

## 完成プレビューと、実装する3ファイル

下のプレビューはレイアウトのサンプルです（クリックしても何も起きません）。
タブを切り替えると、**実際にこの画面を作る3ファイル**を順に読めます。

