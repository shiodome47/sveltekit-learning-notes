<script lang="ts">
	import { ComponentPreview, Step, Steps } from '$lib';
	import AdminBoardDemo from './_AdminBoardDemo.svelte';

	const hooksSource = `// src/hooks.server.ts
//
// 入口の受付係。Cookie を見て locals.user をセットする。
// ここでは仮ユーザー。実務ではセッションストアやDBで照合する。

import type { Handle } from '@sveltejs/kit';

export const handle: Handle = async ({ event, resolve }) => {
	// 実際は event.cookies.get('session') を見てDBで照合する。
	// このページのデモでは「常に admin としてログイン中」とみなす。
	event.locals.user = { name: 'Taro', role: 'admin' };

	return await resolve(event);
};
`;

	const layoutServerSource = `// src/routes/admin/+layout.server.ts
//
// /admin/ 配下まるごとを守る守衛。
// 未ログイン → /login へ案内。
// 権限なし → 403 で止める。

import { error, redirect } from '@sveltejs/kit';
import type { LayoutServerLoad } from './$types';

export const load: LayoutServerLoad = ({ locals }) => {
	if (!locals.user) {
		redirect(303, '/login');
	}

	if (locals.user.role !== 'admin') {
		error(403, '管理者だけが見られます');
	}

	return {
		user: locals.user
	};
};
`;

	const noticesSource = `// src/lib/server/notices.ts
//
// お知らせの保存処理。今回はインメモリ。
// 実務ではDB（Postgres / MySQL / SQLite）に置きかえる。

export type Notice = {
	id: number;
	title: string;
	body: string;
	createdAt: string;
};

let notices: Notice[] = [];
let nextId = 1;

export function getNotices(): Notice[] {
	return [...notices].sort((a, b) => b.createdAt.localeCompare(a.createdAt));
}

export function createNotice(title: string, body: string): Notice {
	const notice: Notice = {
		id: nextId++,
		title,
		body,
		createdAt: new Date().toISOString().slice(0, 10)
	};
	notices.push(notice);
	return notice;
}

export function deleteNotice(id: number): void {
	notices = notices.filter((n) => n.id !== id);
}
`;

	const pageServerSource = `// src/routes/admin/notices/+page.server.ts
//
// 管理画面の load と actions。
// /admin/+layout.server.ts ですでに権限チェック済みなので、
// ここでは「ログイン済みの管理者」前提で書いてOK。

import { fail } from '@sveltejs/kit';
import { createNotice, deleteNotice, getNotices } from '$lib/server/notices';
import type { Actions, PageServerLoad } from './$types';

export const load: PageServerLoad = () => {
	return {
		notices: getNotices()
	};
};

export const actions: Actions = {
	create: async ({ request }) => {
		const data = await request.formData();
		const title = String(data.get('title') ?? '').trim();
		const body = String(data.get('body') ?? '').trim();

		if (title === '' || body === '') {
			return fail(422, {
				error: 'タイトルと本文を入力してください',
				title,
				body
			});
		}

		createNotice(title, body);
		return { ok: true };
	},

	delete: async ({ request }) => {
		const data = await request.formData();
		const id = Number(data.get('id'));
		deleteNotice(id);
		return { ok: true };
	}
};
`;

	const pageSource = `<!-- src/routes/admin/notices/+page.svelte -->
<script lang="ts">
	import { enhance } from '$app/forms';
	let { data, form } = $props();
<\/script>

<header>
	<span class="badge">🛡 管理者：{data.user.name}</span>
	<h1>お知らせ管理</h1>
</header>

{#if form?.error}
	<p class="error" role="alert">{form.error}</p>
{/if}

<form method="POST" action="?/create" use:enhance>
	<input
		type="text"
		name="title"
		placeholder="タイトル"
		value={form?.title ?? ''}
	/>
	<textarea
		name="body"
		placeholder="本文"
		rows="3">{form?.body ?? ''}</textarea>
	<button type="submit">追加</button>
</form>

{#if data.notices.length === 0}
	<p>まだお知らせはありません</p>
{:else}
	<ul>
		{#each data.notices as notice (notice.id)}
			<li>
				<article>
					<h3>{notice.title}</h3>
					<time>{notice.createdAt}</time>
					<p>{notice.body}</p>
				</article>
				<form method="POST" action="?/delete" use:enhance>
					<input type="hidden" name="id" value={notice.id} />
					<button type="submit" aria-label="{notice.title} を削除">×</button>
				</form>
			</li>
		{/each}
	</ul>
{/if}
`;
</script>

## ひとことで言うと

管理画面は、ひとことで言うと

> **「ログインした管理者だけが、お知らせを追加・削除できるページ」**

です。
このサイトでこれまで作ってきた[hooks](/docs/sveltekit/hooks) / [+layout.server.ts](/docs/sveltekit/layout) / [form actions](/docs/sveltekit/form-actions) / [error / redirect](/docs/sveltekit/error-redirect) を**全部一緒に使う**、サイトの集大成ページです。

## たとえ話：掲示板の裏側

普通のお知らせページは「**掲示板を見る場所**」（誰でも見られる）。
管理画面は「**掲示板に紙を貼ったり、古い紙を外したりする裏側の部屋**」です。

| たとえ | コード |
| --- | --- |
| **裏側の部屋の入口** | `src/routes/admin/+layout.server.ts` |
| **誰でも入れたら困るので、入口で確認する人** | `event.locals.user` のチェック |
| **未ログインなら「会員カードはあちらで」** | `redirect(303, '/login')` |
| **ログイン済みでも一般会員なら「ここは管理者専用です」** | `error(403, '...')` |
| **無事通れたら、紙を貼る作業（投稿）** | `actions.create` |
| **紙をはがす作業（削除）** | `actions.delete` |

## このページで作るもの

- **`/admin/notices`** のような管理画面
- **管理者だけ入れる入口チェック**
- お知らせ**一覧の読み込み**
- お知らせ**追加フォーム**
- お知らせ**削除フォーム**
- 権限なしなら **`error(403)`**
- 未ログインなら **`redirect('/login')`**
- 入力ミスなら **`fail(422, ...)`**

## これまでの章とのつながり

このページは、**今まで作ってきた章の総合演習**です。

- [hooks：入口の受付係](/docs/sveltekit/hooks) … `locals.user` をセット
- [+layout.svelte](/docs/sveltekit/layout)・[+page.server.ts](/docs/sveltekit/page-server) … 守衛と画面の役割分担
- [load：表示前の材料集め](/docs/sveltekit/load) … お知らせ一覧の取得
- [form actions](/docs/sveltekit/form-actions) … 追加・削除
- [error / redirect](/docs/sveltekit/error-redirect) … 未ログイン・権限なしの処理
- [お知らせ一覧](/docs/examples/notice-board) … 「**読み出し版**」の同じデータ
- [Todo server版](/docs/examples/todo-server) … `actions` と `fail` の練習
- [class / style](/docs/svelte/class-style) … 管理者バッジ・エラー表示の見た目

## 完成プレビュー

下のプレビューで、管理画面の**動きと見た目**を試せます。
タブを切り替えると、**実際に動かすために必要な5ファイル**が順に読めます。

<ComponentPreview
	sources={[
		{ name: 'src/hooks.server.ts', code: hooksSource, language: 'typescript' },
		{ name: 'src/routes/admin/+layout.server.ts', code: layoutServerSource, language: 'typescript' },
		{ name: 'src/lib/server/notices.ts', code: noticesSource, language: 'typescript' },
		{ name: 'src/routes/admin/notices/+page.server.ts', code: pageServerSource, language: 'typescript' },
