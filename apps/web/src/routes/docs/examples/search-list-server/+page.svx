<script lang="ts">
	import { ComponentPreview, Step, Steps } from '$lib';
	import ServerSearchDemo from './_ServerSearchDemo.svelte';

	const noticesSource = `// src/lib/server/notices.ts
//
// 検索処理の本体。$lib/server/ なのでブラウザに渡らない。
// 今回はインメモリ。実務ではDBに置きかえる。

import type { Notice } from '$lib/types';

const notices: Notice[] = [
	{ slug: 'jizobon', title: '地蔵盆のお知らせ', excerpt: '8月23日（土）に開催。', category: '行事' },
	{ slug: 'bousai-training', title: '防災訓練のお知らせ', excerpt: '9月7日（日）に行います。', category: '防災' },
	{ slug: 'yakuinkai', title: '役員会のお知らせ', excerpt: '10月5日（日）に開催。', category: '会議' }
	// ... 続く
];

export function searchNotices(query: string): Notice[] {
	const q = query.trim();
	if (q === '') return [];

	return notices.filter(
		(n) =>
			n.title.includes(q) ||
			n.excerpt.includes(q) ||
			n.category.includes(q)
	);
}
`;

	const typesSource = `// src/lib/types.ts
//
// クライアント・サーバー両方で使う共通の型と型ガード。

export type Notice = {
	slug: string;
	title: string;
	excerpt: string;
	category: string;
};

export type SearchResponse = {
	results: Notice[];
};

export type AppError = {
	message: string;
	status?: number;
};

export type Result<T, E> =
	| { ok: true; data: T }
	| { ok: false; error: E };

// API レスポンスの形を確認する型ガード
export function isSearchResponse(value: unknown): value is SearchResponse {
	if (typeof value !== 'object' || value === null) return false;
	const v = value as Record<string, unknown>;
	if (!Array.isArray(v.results)) return false;

	return v.results.every((item) => {
		if (typeof item !== 'object' || item === null) return false;
		const n = item as Record<string, unknown>;
		return (
			typeof n.slug === 'string' &&
			typeof n.title === 'string' &&
			typeof n.excerpt === 'string' &&
			typeof n.category === 'string'
		);
	});
}
`;

	const apiSource = `// src/routes/api/notices/search/+server.ts
//
// 検索APIの受付窓口。fetch から呼ばれる。

import { json } from '@sveltejs/kit';
import { searchNotices } from '$lib/server/notices';
import type { SearchResponse } from '$lib/types';

export function GET({ url }) {
	const q = url.searchParams.get('q') ?? '';

	if (q.trim() === '') {
		const empty: SearchResponse = { results: [] };
		return json(empty);
	}

	const results = searchNotices(q);
	const response: SearchResponse = { results };
	return json(response);
}
`;

	const clientSource = `// src/lib/client/search.ts
//
// クライアント側の検索ヘルパー。Result<T, E> で成功/失敗を返す。

import { isSearchResponse } from '$lib/types';
import type { AppError, Notice, Result } from '$lib/types';

export async function fetchSearchResults(
	query: string
): Promise<Result<Notice[], AppError>> {
	try {
		const res = await fetch(
			\`/api/notices/search?q=\${encodeURIComponent(query)}\`
		);

		if (!res.ok) {
			return {
				ok: false,
				error: { message: '検索に失敗しました', status: res.status }
			};
		}

		const data: unknown = await res.json();

		if (!isSearchResponse(data)) {
			return {
				ok: false,
				error: { message: '検索結果の形が違います' }
			};
		}

		return { ok: true, data: data.results };
	} catch (e) {
		return {
			ok: false,
			error: {
				message: e instanceof Error ? e.message : '不明なエラーです'
			}
		};
	}
}
`;

	const pageSource = `<!-- src/routes/notices-search/+page.svelte -->
<script lang="ts">
	import { fetchSearchResults } from '$lib/client/search';
	import type { Notice } from '$lib/types';

	type State =
		| { kind: 'idle' }
		| { kind: 'loading' }
		| { kind: 'error'; message: string }
		| { kind: 'success'; results: Notice[]; query: string };

	let query = $state('');
	let state = $state<State>({ kind: 'idle' });

	$effect(() => {
		const q = query.trim();

		if (q === '') {
			state = { kind: 'idle' };
			return;
		}

		let cancelled = false;

		const timer = setTimeout(async () => {
			state = { kind: 'loading' };
			const result = await fetchSearchResults(q);
			if (cancelled) return;
			if (result.ok) {
				state = { kind: 'success', results: result.data, query: q };
			} else {
				state = { kind: 'error', message: result.error.message };
			}
		}, 500);

		return () => {
			cancelled = true;
			clearTimeout(timer);
		};
	});
<\/script>

<h1>お知らせを検索</h1>

<input type="search" bind:value={query} placeholder="検索ワード" />

{#if state.kind === 'idle'}
	<p>検索ワードを入れてください</p>
{:else if state.kind === 'loading'}
	<p>サーバーに問い合わせ中…</p>
{:else if state.kind === 'error'}
	<p class="error">{state.message}</p>
{:else if state.results.length === 0}
	<p>「{state.query}」に合うお知らせは見つかりません</p>
{:else}
	<p>{state.results.length} 件見つかりました</p>
	<ul>
		{#each state.results as notice (notice.slug)}
			<li>
				<strong>{notice.title}</strong>
				<span>{notice.excerpt}</span>
			</li>
		{/each}
	</ul>
{/if}
`;
</script>

## ひとことで言うと

サーバー検索リストは、ひとことで言うと

> **「検索キーワードをサーバーに送り、サーバーで絞り込んだ結果を返してもらう仕組み」**

です。
このサイトでこれまで作ってきた **search-list / debounce-search / api-routes / Result型 / 型ガード / 4状態UI** を**全部つなげる**集大成実例です。

## たとえ話：手元のカード vs 受付の奥の棚

| たとえ | コード |
| --- | --- |
| **手元のカード**から探す | [検索リスト](/docs/examples/search-list)（ブラウザ内 `filter`） |
| **受付に渡して、奥の棚から探してもらう** | このページ（サーバー検索） |

カードが**少ない**なら手元で十分。
カードが**多い**なら、受付（API）に渡して**奥の棚（DB / サーバー）**で探してもらうのが自然です。
**サイトが大きくなるにつれて、後者が必要**になります。

## このページで作るもの

- **検索欄**（debounce 付き）
- **`/api/notices/search`** API
- **`fetch`** で検索リクエスト
- **Result 型**で成功/失敗を扱う
- **型ガード**でレスポンスを安全に確認
- **idle / loading / error / empty / success** の5状態UI

## これまでの章とのつながり

このページは、**6章の合流点**です。

- [検索リスト](/docs/examples/search-list)：クライアント側 filter の出発点
- [debounce検索](/docs/patterns/debounce-search)：入力を待ってから1回だけ
- [+server.ts](/docs/sveltekit/api-routes)：検索APIの作り方
- [4状態UI](/docs/patterns/loading-error)：表示の出し分け
- [Result型](/docs/typescript/result-pattern)：成功/失敗を型で扱う
- [型ガード](/docs/typescript/type-guard)：unknown を安全に絞り込む
- [APIレスポンス](/docs/typescript/api-response)：レスポンスに型を貼る
- [$effect](/docs/svelte/effect) ＋ [bind](/docs/svelte/bind)：debounce の中身

## ブラウザ内検索とサーバー検索の違い

| 観点 | **ブラウザ内検索** | **サーバー検索** |
| --- | --- | --- |
| **データ量** | 少ない（数十〜数百件） | 多い（千件〜何百万件） |
| **どこで絞る？** | クライアント側 `filter` | サーバー側（DB / 全文検索） |
| **相性のよい仕組み** | [`$derived`](/docs/svelte/derived) | [`+server.ts`](/docs/sveltekit/api-routes) ＋ debounce |
| **権限チェック** | できない（全データを見られる） | **できる**（API 側で判断） |
| **DB 検索（`LIKE` / 全文）** | できない | できる |
| **速さ** | 瞬間的 | 通信があるぶん少し遅い |
| **実装の手間** | 少ない | 少し多い（API + 型 + Result + UI） |

> **「データが手のひらに収まる量」**なら[検索リスト](/docs/examples/search-list)、**「データが棚に並ぶ量」**ならこのページ、と覚えれば十分です。

## 完成プレビュー

下のプレビューで疑似サーバー検索を試せます（debounce 500ms ＋ 疑似応答 600ms）。
**`error`** と入れると、サーバーエラーを再現します。
タブを切り替えると、**実際にこの画面を作る5ファイル**が読めます。

